      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "rate(queueguard_worker_job_processing_duration_seconds_sum[5m]) / rate(queueguard_worker_job_processing_duration_seconds_count[5m])", "legendFormat": "worker average", "refId": "A"}],
      "title": "Worker job processing duration",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum by (outcome) (rate(queueguard_worker_jobs_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "title": "Worker job throughput and outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "queueguard_worker_jobs_in_flight", "legendFormat": "in flight", "refId": "A"}],
      "title": "Worker in-flight jobs",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "rate(queueguard_inbox_processing_duration_seconds_sum[5m]) / rate(queueguard_inbox_processing_duration_seconds_count[5m])", "legendFormat": "inbox average", "refId": "A"}],
      "title": "Event consumer processing duration",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
